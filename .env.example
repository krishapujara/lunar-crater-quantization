# Micro-Quantized CNN Environment Configuration Example
# Copy this file to .env and adjust variables as required.
# NEVER commit .env to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Project Paths (Defaults are relative to project root)
# DATA_DIR=data
# ARTIFACTS_DIR=artifacts

# Optional Database Integration (PostgreSQL)
# When unset or empty, SQLite / JSON storage is used automatically.
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Model & Training Defaults
DEFAULT_DEVICE=cpu
DEFAULT_BATCH_SIZE=4
DEFAULT_EPOCHS=10
DEFAULT_CONFIDENCE_THRESHOLD=0.35

# Quantization
QUANTIZATION_METHOD=dynamic_int8
